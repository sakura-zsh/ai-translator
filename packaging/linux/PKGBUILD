# Maintainer: sakura
pkgname=ai-translator
pkgver=0.6.0
pkgrel=1
pkgdesc="Lightweight cross-platform AI translator (Tauri v2 + Rust)"
arch=('x86_64')
url="https://github.com/anomalyco/ai-translator"
license=('MIT')
options=('!lto')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libappindicator-gtk3'
  'openssl'
)
makedepends=(
  'rust'
  'cargo'
  'nodejs'
  'pnpm'
)
optdepends=(
  'grim: Wayland screenshot capture'
  'slurp: Wayland region selection'
  'wl-clipboard: clipboard image paste and CLI copy'
  'libnotify: CLI desktop notifications'
  'tesseract: OCR image translation mode'
  'tesseract-data-eng: English OCR language data'
  'tesseract-data-chi_sim: Simplified Chinese OCR language data'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  pnpm install --frozen-lockfile --allow-build esbuild || pnpm install --allow-build esbuild
  pnpm build
  cargo build --release --locked -p ai-translator --features custom-protocol || \
    cargo build --release -p ai-translator --features custom-protocol
  cargo build --release --locked -p ai-translator-cli || \
    cargo build --release -p ai-translator-cli
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/ai-translator \
    "$pkgdir/usr/bin/ai-translator"
  install -Dm755 target/release/ai-translator-cli \
    "$pkgdir/usr/bin/ai-translator-cli"

  install -Dm644 packaging/linux/ai-translator.desktop \
    "$pkgdir/usr/share/applications/ai-translator.desktop"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/ai-translator.png"

  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
